{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/types.d.ts",
  "apiReport": {
    "enabled": true,
    "reportFileName": "client-types.api.md",
    "reportFolder": "<projectFolder>/../api",
    "reportTempFolder": "<projectFolder>/../../tmp/api"
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      "ae-forgotten-export": {
        "logLevel": "none",
        "addToApiReportFile": false
      },
      "ae-unresolved-link": {
        "logLevel": "none"
      }
    }
  },
  "newlineKind": "lf"
}
