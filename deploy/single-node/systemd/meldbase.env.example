# Copy to /etc/meldbase/meldbase.env, set ownership to root:meldbase and mode
# 0640. The JWT secret file must be readable by the meldbase service account,
# mode 0640 and owned by root:meldbase.
MELDBASE_BIN=/usr/local/bin/meld
MELDBASE_DB=/var/lib/meldbase/data/app.meld
MELDBASE_ADDR=127.0.0.1:8080
MELDBASE_ADMIN_ADDR=127.0.0.1:9091
MELDBASE_ADMIN_TOKEN=CHANGE_ME_GENERATE_A_RANDOM_TOKEN
MELDBASE_JWT_HS256_SECRET_FILE=/etc/meldbase/jwt-hs256.secret
# During a bounded rotation window, set this to the former signing secret.
# Remove it after the longest issued-token lifetime and clock-skew window.
MELDBASE_JWT_HS256_PREVIOUS_SECRET_FILE=
# Alternative to the HS256 secret: an absolute HTTPS OIDC/JWKS endpoint for
# RS256 access tokens. Leave blank for the supplied local-secret deployment.
MELDBASE_JWT_JWKS_URL=
MELDBASE_JWT_ISSUER=https://identity.example/
MELDBASE_JWT_AUDIENCE=meldbase-api
MELDBASE_ACCESS_POLICY_FILE=/etc/meldbase/access-policy.json
# These values define the browser boundary at the TLS proxy. Use exact HTTP(S)
# origins for API requests and matching scheme+host patterns for WebSocket
# upgrades. Keep the defaults for a loopback-only local application.
MELDBASE_PUBLIC_REALTIME_URL=
MELDBASE_HTTP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
MELDBASE_REALTIME_ORIGIN_PATTERNS=localhost:*,127.0.0.1:*,[[]::1]:*
# Leave all four values blank to disable in-process scheduled backups. Otherwise
# set all four; the backup directory must be below /var/lib/meldbase for the
# supplied systemd sandbox policy.
MELDBASE_BACKUP_DIR=
MELDBASE_BACKUP_INTERVAL=
MELDBASE_BACKUP_KEEP=
MELDBASE_BACKUP_TIMEOUT=
# Optional separate rehearsal directory. A successful scheduled backup is
# restored and verified there; only a private drill receipt remains afterward.
MELDBASE_BACKUP_DRILL_DIR=
# Optional strict JSON ResourceLimits file. Leave blank for the immutable
# production defaults. Tune from target-machine capacity evidence and restart
# the service for a change to take effect.
MELDBASE_RESOURCE_LIMITS_FILE=
# Resume durable online index builds after a restart in bounded background
# slices. Set to 0 only when an operator will drive `meld index-build resume`.
MELDBASE_INDEX_BUILD_SCHEDULER=1
# JSONL operational lifecycle and backup events. Security/admin audit events
# are always retained regardless of this threshold.
MELDBASE_LOG_LEVEL=info
# Optional in-process HTTP rate limit. All three rate values are required when
# enabled. Trusted proxies must overwrite X-Forwarded-For before this is set.
MELDBASE_RATE_LIMIT_PER_MINUTE=
MELDBASE_RATE_LIMIT_BURST=
MELDBASE_RATE_LIMIT_SUBJECTS=
MELDBASE_TRUSTED_PROXY_CIDRS=
