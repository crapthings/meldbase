#!/bin/sh
set -eu

# This launcher runs the current JWT/collection-policy server path. Keep the
# public listener on loopback until an application-owned TLS proxy is configured.
# Selects the Meldbase executable.
: "${MELDBASE_BIN:=/usr/local/bin/meld}"
# Selects the database file.
: "${MELDBASE_DB:=/var/lib/meldbase/data/app.meld}"
# Sets the public server listen address.
: "${MELDBASE_ADDR:=127.0.0.1:8080}"
# Sets the administration listen address.
: "${MELDBASE_ADMIN_ADDR:=127.0.0.1:9091}"
# Reads the administration bearer token from the environment.
: "${MELDBASE_ADMIN_TOKEN:=}"
# Selects the current JWT signing secret file.
: "${MELDBASE_JWT_HS256_SECRET_FILE:=}"
# Selects the previous JWT secret accepted during key rotation.
: "${MELDBASE_JWT_HS256_PREVIOUS_SECRET_FILE:=}"
# Selects the public key endpoint for RSA JWT verification.
: "${MELDBASE_JWT_JWKS_URL:=}"
# Sets the required JWT issuer.
: "${MELDBASE_JWT_ISSUER:=}"
# Sets the required JWT audience.
: "${MELDBASE_JWT_AUDIENCE:=}"
# Selects the collection access manifest.
: "${MELDBASE_ACCESS_POLICY_FILE:=}"
# Sets the realtime URL advertised to clients.
: "${MELDBASE_PUBLIC_REALTIME_URL:=}"
# Sets the allowed HTTP browser origins.
: "${MELDBASE_HTTP_ORIGINS:=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173}"
# Sets the allowed realtime browser origin patterns.
: "${MELDBASE_REALTIME_ORIGIN_PATTERNS:=localhost:*,127.0.0.1:*,[[]::1]:*}"
# Selects the scheduled backup directory.
: "${MELDBASE_BACKUP_DIR:=}"
# Sets the time between scheduled backups.
: "${MELDBASE_BACKUP_INTERVAL:=}"
# Sets the number of scheduled backups to retain.
: "${MELDBASE_BACKUP_KEEP:=}"
# Sets the deadline for each scheduled backup.
: "${MELDBASE_BACKUP_TIMEOUT:=}"
# Selects the directory for scheduled restore drills.
: "${MELDBASE_BACKUP_DRILL_DIR:=}"
# Selects the database resource limits file.
: "${MELDBASE_RESOURCE_LIMITS_FILE:=}"
# Controls whether unfinished index builds resume automatically.
: "${MELDBASE_INDEX_BUILD_SCHEDULER:=1}"
# Sets the minimum service log level.
: "${MELDBASE_LOG_LEVEL:=info}"
# Sets the allowed request rate per subject.
: "${MELDBASE_RATE_LIMIT_PER_MINUTE:=}"
# Sets the allowed request burst per subject.
: "${MELDBASE_RATE_LIMIT_BURST:=}"
# Limits the number of tracked rate-limit subjects.
: "${MELDBASE_RATE_LIMIT_SUBJECTS:=}"
# Sets the proxy networks trusted to supply client addresses.
: "${MELDBASE_TRUSTED_PROXY_CIDRS:=}"

case "$MELDBASE_ADDR" in
  127.*:*|'[::1]':*) ;;
  *)
    printf '%s\n' 'MELDBASE_ADDR must be a loopback address; place TLS at the application boundary' >&2
    exit 2
    ;;
esac
case "$MELDBASE_ADMIN_ADDR" in
  127.*:*|'[::1]':*) ;;
  *)
    printf '%s\n' 'MELDBASE_ADMIN_ADDR must be a loopback address' >&2
    exit 2
    ;;
esac
if [ "${#MELDBASE_ADMIN_TOKEN}" -lt 32 ] || [ "$MELDBASE_ADMIN_TOKEN" = CHANGE_ME_GENERATE_A_RANDOM_TOKEN ]; then
  printf '%s\n' 'MELDBASE_ADMIN_TOKEN must be a unique random token of at least 32 bytes' >&2
  exit 2
fi
if [ -n "$MELDBASE_JWT_HS256_SECRET_FILE" ] && [ -n "$MELDBASE_JWT_JWKS_URL" ]; then
  printf '%s\n' 'configure MELDBASE_JWT_HS256_SECRET_FILE or MELDBASE_JWT_JWKS_URL, not both' >&2
  exit 2
fi
if [ -z "$MELDBASE_JWT_HS256_SECRET_FILE$MELDBASE_JWT_JWKS_URL" ]; then
  printf '%s\n' 'configure MELDBASE_JWT_HS256_SECRET_FILE or MELDBASE_JWT_JWKS_URL' >&2
  exit 2
fi
if [ -n "$MELDBASE_JWT_HS256_SECRET_FILE" ] && [ ! -r "$MELDBASE_JWT_HS256_SECRET_FILE" ]; then
  printf '%s\n' 'MELDBASE_JWT_HS256_SECRET_FILE must name a readable 32+ byte secret file' >&2
  exit 2
fi
if [ -n "$MELDBASE_JWT_HS256_PREVIOUS_SECRET_FILE" ] && [ -z "$MELDBASE_JWT_HS256_SECRET_FILE" ]; then
  printf '%s\n' 'MELDBASE_JWT_HS256_PREVIOUS_SECRET_FILE requires MELDBASE_JWT_HS256_SECRET_FILE' >&2
  exit 2
fi
if [ -n "$MELDBASE_JWT_HS256_PREVIOUS_SECRET_FILE" ] && [ ! -r "$MELDBASE_JWT_HS256_PREVIOUS_SECRET_FILE" ]; then
  printf '%s\n' 'MELDBASE_JWT_HS256_PREVIOUS_SECRET_FILE must name a readable previous secret file when set' >&2
  exit 2
fi
if [ -z "$MELDBASE_JWT_ISSUER" ] || [ -z "$MELDBASE_JWT_AUDIENCE" ]; then
  printf '%s\n' 'MELDBASE_JWT_ISSUER and MELDBASE_JWT_AUDIENCE are required' >&2
  exit 2
fi
if [ -z "$MELDBASE_ACCESS_POLICY_FILE" ] || [ ! -r "$MELDBASE_ACCESS_POLICY_FILE" ]; then
  printf '%s\n' 'MELDBASE_ACCESS_POLICY_FILE must name a readable manifest' >&2
  exit 2
fi
set -- "$@" \
  --http-origins "$MELDBASE_HTTP_ORIGINS" \
  --realtime-origin-patterns "$MELDBASE_REALTIME_ORIGIN_PATTERNS"
if [ -n "$MELDBASE_PUBLIC_REALTIME_URL" ]; then
  set -- "$@" --public-realtime-url "$MELDBASE_PUBLIC_REALTIME_URL"
fi
if [ -n "$MELDBASE_BACKUP_DIR$MELDBASE_BACKUP_INTERVAL$MELDBASE_BACKUP_KEEP$MELDBASE_BACKUP_TIMEOUT" ]; then
  if [ -z "$MELDBASE_BACKUP_DIR" ] || [ -z "$MELDBASE_BACKUP_INTERVAL" ] || [ -z "$MELDBASE_BACKUP_KEEP" ] || [ -z "$MELDBASE_BACKUP_TIMEOUT" ]; then
    printf '%s\n' 'MELDBASE_BACKUP_DIR, MELDBASE_BACKUP_INTERVAL, MELDBASE_BACKUP_KEEP, and MELDBASE_BACKUP_TIMEOUT must be set together' >&2
    exit 2
  fi
  set -- "$@" \
    --backup-dir "$MELDBASE_BACKUP_DIR" \
    --backup-interval "$MELDBASE_BACKUP_INTERVAL" \
    --backup-keep "$MELDBASE_BACKUP_KEEP" \
    --backup-timeout "$MELDBASE_BACKUP_TIMEOUT"
  if [ -n "$MELDBASE_BACKUP_DRILL_DIR" ]; then
    set -- "$@" --backup-drill-dir "$MELDBASE_BACKUP_DRILL_DIR"
  fi
fi
if [ -n "$MELDBASE_RESOURCE_LIMITS_FILE" ]; then
  if [ ! -r "$MELDBASE_RESOURCE_LIMITS_FILE" ]; then
    printf '%s\n' 'MELDBASE_RESOURCE_LIMITS_FILE must name a readable strict JSON ResourceLimits file' >&2
    exit 2
  fi
  set -- "$@" --resource-limits-file "$MELDBASE_RESOURCE_LIMITS_FILE"
fi
if [ -n "$MELDBASE_RATE_LIMIT_PER_MINUTE$MELDBASE_RATE_LIMIT_BURST$MELDBASE_RATE_LIMIT_SUBJECTS$MELDBASE_TRUSTED_PROXY_CIDRS" ]; then
  if [ -z "$MELDBASE_RATE_LIMIT_PER_MINUTE" ] || [ -z "$MELDBASE_RATE_LIMIT_BURST" ] || [ -z "$MELDBASE_RATE_LIMIT_SUBJECTS" ]; then
    printf '%s\n' 'MELDBASE_RATE_LIMIT_PER_MINUTE, MELDBASE_RATE_LIMIT_BURST, and MELDBASE_RATE_LIMIT_SUBJECTS must be set together' >&2
    exit 2
  fi
  set -- "$@" --rate-limit-per-minute "$MELDBASE_RATE_LIMIT_PER_MINUTE" --rate-limit-burst "$MELDBASE_RATE_LIMIT_BURST" --rate-limit-subjects "$MELDBASE_RATE_LIMIT_SUBJECTS"
  if [ -n "$MELDBASE_TRUSTED_PROXY_CIDRS" ]; then
    set -- "$@" --trusted-proxy-cidrs "$MELDBASE_TRUSTED_PROXY_CIDRS"
  fi
fi
if [ -n "$MELDBASE_JWT_HS256_PREVIOUS_SECRET_FILE" ]; then
  set -- "$@" --jwt-hs256-previous-secret-file "$MELDBASE_JWT_HS256_PREVIOUS_SECRET_FILE"
fi
case "$MELDBASE_LOG_LEVEL" in
  debug|info|warn|error) set -- "$@" --log-level "$MELDBASE_LOG_LEVEL" ;;
  *)
    printf '%s\n' 'MELDBASE_LOG_LEVEL must be debug, info, warn, or error' >&2
    exit 2
    ;;
esac
case "$MELDBASE_INDEX_BUILD_SCHEDULER" in
  0) ;;
  1) set -- "$@" --index-build-scheduler ;;
  *)
    printf '%s\n' 'MELDBASE_INDEX_BUILD_SCHEDULER must be 0 or 1' >&2
    exit 2
    ;;
esac

if [ -n "$MELDBASE_JWT_HS256_SECRET_FILE" ]; then
  exec "$MELDBASE_BIN" serve \
    --db "$MELDBASE_DB" \
    --addr "$MELDBASE_ADDR" \
    --jwt-hs256-secret-file "$MELDBASE_JWT_HS256_SECRET_FILE" \
    --jwt-issuer "$MELDBASE_JWT_ISSUER" \
    --jwt-audience "$MELDBASE_JWT_AUDIENCE" \
    --access-policy-file "$MELDBASE_ACCESS_POLICY_FILE" \
    "$@" \
    --admin-addr "$MELDBASE_ADMIN_ADDR" \
    --admin-diagnostics \
    --admin-metrics
fi

exec "$MELDBASE_BIN" serve \
  --db "$MELDBASE_DB" \
  --addr "$MELDBASE_ADDR" \
  --jwt-jwks-url "$MELDBASE_JWT_JWKS_URL" \
  --jwt-issuer "$MELDBASE_JWT_ISSUER" \
  --jwt-audience "$MELDBASE_JWT_AUDIENCE" \
  --access-policy-file "$MELDBASE_ACCESS_POLICY_FILE" \
  "$@" \
  --admin-addr "$MELDBASE_ADMIN_ADDR" \
  --admin-diagnostics \
  --admin-metrics
